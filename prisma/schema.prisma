generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique // unikátní slug pro URL
  description     String
  date            DateTime
  location        String
  ownerId         String?
  address         String?
  allowResale     Boolean      @default(false)
  capacity        Int?
  category        String?
  createdAt       DateTime     @default(now())
  endTime         String?
  image           String?
  requireApproval Boolean      @default(false)
  salesEnd        DateTime?
  salesStart      DateTime?
  sendEmails      Boolean      @default(true)
  startTime       String?
  updatedAt       DateTime?
  venue           String?
  owner           User?        @relation("EventOwner", fields: [ownerId], references: [id])
  tickets         Ticket[]
  ticketTypes     TicketType[]
  status          EventStatus  @default(DRAFT)

  @@unique([name, date]) // validace: stejný název eventu nemůže být v ten samý den
}

model Ticket {
  id           String     @id @default(cuid())
  eventid      String
  ownerId      String?
  listingId    String?
  createtime   DateTime   @default(now())
  used         Boolean    @default(false)
  accesscode   String     @unique
  tickettypeid String
  lastScanned  DateTime?
  qrGenerated  DateTime   @default(now())
  scanCount    Int        @default(0)
  event        Event      @relation(fields: [eventid], references: [id], onDelete: Cascade)
  tickettype   TicketType @relation(fields: [tickettypeid], references: [id], onDelete: Cascade)
  owner        User?      @relation(fields: [ownerId], references: [id])
  listing      Listing?   @relation("ListingTickets", fields: [listingId], references: [id], onDelete: SetNull)
}

enum Role {
  USER
  ORGANIZER
  ADMIN
  AUTHENTICATOR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createtime    DateTime  @default(now())
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  accounts      Account[]
  ownedEvents   Event[]   @relation("EventOwner")
  sessions      Session[]
  ownedTickets  Ticket[]
  listings      Listing[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TicketType {
  id      String   @id @default(cuid())
  name    String
  price   Int
  stock   Int
  total   Int
  eventid String
  tickets Ticket[]
  event   Event    @relation(fields: [eventid], references: [id], onDelete: Cascade)
}

enum ListingStatus {
  IN_SALE
  SOLD
}

enum ListingType {
  OFFER // nabídka k prodeji
  REQUEST // poptávka
}

model Listing {
  id        String        @id @default(cuid())
  tickets   Ticket[]      @relation("ListingTickets")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  price     Int // cena za kus (Kč)
  status    ListingStatus @default(IN_SALE)
  type      ListingType   @default(OFFER)
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}
